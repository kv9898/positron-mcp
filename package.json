{
  "name": "positron-codex-mcp",
  "displayName": "Positron Codex MCP",
  "description": "Expose the foreground Positron R or Python session to trusted local MCP clients.",
  "version": "0.1.0",
  "publisher": "kv9898",
  "author": {
    "name": "Dianyi Yang",
    "email": "dianyi.yang@politics.ox.ac.uk"
  },
  "license": "MIT",
  "private": true,
  "repository": {
    "type": "git",
    "url": "https://github.com/kv9898/positron-mcp.git"
  },
  "homepage": "https://github.com/kv9898/positron-mcp#readme",
  "bugs": {
    "url": "https://github.com/kv9898/positron-mcp/issues"
  },
  "engines": {
    "vscode": "^1.103.0",
    "positron": "^2026.09.1"
  },
  "categories": [
    "Other"
  ],
  "keywords": [
    "positron",
    "mcp",
    "codex",
    "r",
    "python"
  ],
  "activationEvents": [
    "onStartupFinished",
    "onCommand:positronCodexMcp.start"
  ],
  "main": "./dist/extension.js",
  "icon": "images/icon.png",
  "extensionKind": [
    "workspace"
  ],
  "contributes": {
    "commands": [
      {
        "command": "positronCodexMcp.start",
        "title": "Positron Codex: Start MCP Server"
      },
      {
        "command": "positronCodexMcp.stop",
        "title": "Positron Codex: Stop MCP Server"
      },
      {
        "command": "positronCodexMcp.restart",
        "title": "Positron Codex: Restart MCP Server"
      },
      {
        "command": "positronCodexMcp.showEndpoint",
        "title": "Positron Codex: Show MCP Endpoint"
      },
      {
        "command": "positronCodexMcp.copyEndpoint",
        "title": "Positron Codex: Copy MCP Endpoint"
      },
      {
        "command": "positronCodexMcp.copyCodexSetup",
        "title": "Positron Codex: Copy Codex MCP Setup Commands"
      },
      {
        "command": "positronCodexMcp.copyCodexSkillInstall",
        "title": "Positron Codex: Copy Codex Skill Install Command"
      },
      {
        "command": "positronCodexMcp.showDiagnostics",
        "title": "Positron Codex: Show Diagnostics"
      }
    ],
    "configuration": {
      "title": "Positron Codex MCP",
      "properties": {
        "positronCodexMcp.autoStart": {
          "type": "boolean",
          "default": true,
          "description": "Start the localhost MCP server when Positron finishes starting."
        },
        "positronCodexMcp.port": {
          "type": "integer",
          "default": 37821,
          "minimum": 0,
          "maximum": 65535,
          "scope": "window",
          "description": "Stable local TCP port used by Codex. The default is 37821. Use 0 only when you explicitly want a new automatically selected port."
        },
        "positronCodexMcp.executionTimeoutMs": {
          "type": "integer",
          "default": 60000,
          "minimum": 1000,
          "maximum": 600000,
          "description": "Maximum time to wait for a live-runtime execution before requesting interruption."
        },
        "positronCodexMcp.maxOutputCharacters": {
          "type": "integer",
          "default": 100000,
          "minimum": 1000,
          "maximum": 1000000,
          "description": "Maximum captured characters for each stdout/stderr stream and serialized execution result."
        }
      }
    }
  },
  "scripts": {
    "build": "node esbuild.mjs",
    "build:watch": "node esbuild.mjs --watch",
    "check": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "package": "pnpm run build && vsce package --no-dependencies"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.30.0",
    "@posit-dev/positron": "0.2.10",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/express": "^5.0.0",
    "@types/node": "^24.0.0",
    "@types/vscode": "^1.103.0",
    "@vscode/vsce": "^3.9.2",
    "esbuild": "^0.25.0",
    "typescript": "^5.9.0",
    "vitest": "^3.2.0"
  }
}
